{
    "name": "meetmage/module-security-health-check",
    "description": "Admin dashboard and weekly email that flag an outdated or end-of-life Magento or PHP version, Composer packages with known security advisories, and missing hardening settings.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento2",
        "magento",
        "adobe-commerce",
        "security",
        "pci-dss",
        "composer-audit",
        "end-of-life",
        "security-patches"
    ],
    "authors": [
        {
            "name": "Meet Shekhat",
            "email": "meetshekhat1988@gmail.com",
            "homepage": "https://meetshekhat.com"
        }
    ],
    "homepage": "https://github.com/meetmage-extensions/magento2-module-security-health-check",
    "support": {
        "issues": "https://github.com/meetmage-extensions/magento2-module-security-health-check/issues",
        "source": "https://github.com/meetmage-extensions/magento2-module-security-health-check"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "composer/semver": "^3.0",
        "magento/framework": "^103.0",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-store": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "bitexpert/phpstan-magento": "^0.32",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "MeetMage\\SecurityHealthCheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MeetMage\\SecurityHealthCheck\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "phpstan/extension-installer": true,
            "laminas/laminas-dependency-plugin": false
        }
    }
}
