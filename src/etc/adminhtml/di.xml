<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Dashboard notice while critical or high issues are open -->
    <virtualType name="MeetMageShcNotice" type="MeetMage\SecurityHealthCheck\Model\System\Message\SeriousIssues"/>
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="meetmage_shc_issues" xsi:type="string">MeetMageShcNotice</item>
            </argument>
        </arguments>
    </type>
</config>
