<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="MeetMage_SecurityHealthCheck::css/report.css"/>
    </head>
    <!-- MeetMageShcReportView = MeetMage\SecurityHealthCheck\ViewModel\ReportView (etc/di.xml) -->
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template" name="meetmage.shc.report"
                   template="MeetMage_SecurityHealthCheck::report.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">MeetMageShcReportView</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
